{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "lookout_tuesday_draft",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "generate_draft": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageLookout",
            "args": {
              "action": "scheduledGenerate"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Prepare The Lookout",
            "description": "Recorded ALSight data and saved department submissions"
          }
        }
      }
    ]
  },
  "name": "The Lookout Tuesday Draft",
  "description": "Generates a weekly internal newsletter draft at 9am Tuesday UK time for administrator editorial review and approval.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 9 * * 2",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}