{
  "description": "Emails the complete expired and next-28-days insurance report to administrator-selected internal users on the 20th at 6am UK time. Disabled settings or no recipients produce no email.",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "monthly_insurance_expiry_report",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "prepare": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageInsuranceReports",
            "args": {
              "action": "prepare"
            }
          },
          "then": "check_01",
          "x-base44": {
            "title": "Prepare insurance expiry report",
            "description": "All expired and next-28-days policies"
          }
        }
      },
      {
        "check_01": {
          "switch": [
            {
              "when": "${ (.prepare.recipients // [] | length) > 0 }",
              "then": "email_01"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Check first configured recipient"
          }
        }
      },
      {
        "email_01": {
          "call": "send_email",
          "with": {
            "template_name": "MonthlyInsuranceReport",
            "to": "${ .prepare.recipients[0] }",
            "description": "Complete expired and expiring insurance report",
            "variables": {
              "report_date": "${ .prepare.variables.report_date }",
              "window_end": "${ .prepare.variables.window_end }",
              "expired_count": "${ .prepare.variables.expired_count }",
              "expiring_count": "${ .prepare.variables.expiring_count }",
              "expired_rows": "${ .prepare.variables.expired_rows }",
              "expiring_rows": "${ .prepare.variables.expiring_rows }"
            }
          },
          "then": "check_02",
          "x-base44": {
            "title": "Email insurance report to recipient 1"
          }
        }
      },
      {
        "check_02": {
          "switch": [
            {
              "when": "${ (.prepare.recipients // [] | length) > 1 }",
              "then": "email_02"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Check recipient 2"
          }
        }
      },
      {
        "email_02": {
          "call": "send_email",
