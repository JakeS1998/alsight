{
  "name": "Sync project counter changes to Dataverse",
  "description": "Reconcile both counters when the ALS Hub last-used project number changes, excluding changes made by reconciliation itself.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ProjectNumberCounter",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.key == \"primary\" and .trigger.data.changed_by != \"dataverse_counter_sync\" and (.trigger.event_type == \"create\" or .trigger.data.last_used != .trigger.old_data.last_used) }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "project_counter_change_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "finish_number_reservation": {
          "wait": "PT10S",
          "then": "reconcile_counter",
          "x-base44": {
            "title": "Allow numbering to finish",
            "description": "Keep the existing reservation lock intact"
          }
        }
      },
      {
        "reconcile_counter": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "syncProjectNumberCounter",
            "args": {
              "action": "sync"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Synchronise project counters",
            "description": "Propagate changes without a feedback loop"
          }
        }
      }
    ]
  }
}