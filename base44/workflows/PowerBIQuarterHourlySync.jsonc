          "with": {
            "function_name": "managePowerBIOrders",
            "args": {
              "action": "sync",
              "generation": "${ .begin_sync.generation }",
              "attempt": 9,
              "batches": 3
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Finish bounded import window",
            "description": "Publish if complete; otherwise resume next quarter hour"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Power BI Automatic Sync Every 15 Minutes",
  "description": "Imports Power BI purchase orders and client invoices on the same quarter-hour cadence as Dataverse, independently so a failure in one source does not stop the other. Uses previously confirmed mappings, reconciles before automatically publishing, and retains the last confirmed snapshot on failure. Processes a finite window of up to 30 protected batches; larger imports resume on the next scheduled pass."
}