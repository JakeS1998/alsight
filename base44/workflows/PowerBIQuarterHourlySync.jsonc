{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "powerbi_quarter_hourly_sync",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "begin_sync": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "managePowerBIOrders",
            "args": {
              "action": "sync",
              "begin": true
            }
          },
          "then": "check_start",
          "x-base44": {
            "title": "Start or resume Power BI sync",
            "description": "Use previously confirmed mappings"
          }
        }
      },
      {
        "check_start": {
          "switch": [
            {
              "when": "${ .begin_sync.status == \"running\" }",
              "then": "batch_1"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Check import availability",
            "description": "Protect pending manual reviews"
          }
        }
      },
      {
        "batch_1": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "managePowerBIOrders",
            "args": {
              "action": "sync",
              "generation": "${ .begin_sync.generation }",
              "attempt": 0,
              "batches": 3
            }
          },
          "then": "check_1",
          "x-base44": {
            "title": "Import order batch window 1",
            "description": "Reconcile and publish when complete"
          }
        }
      },
      {
        "check_1": {
          "switch": [
            {
              "when": "${ .batch_1.status == \"running\" }",
              "then": "batch_2"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Check window 1 progress"
          }
        }
      },
      {
        "batch_2": {
          "call": "invoke_backend_function",
