{
  "description": "Queues opt-in personal briefings at each user's chosen local time, at most once per day.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/5 * * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "personal_briefing_scheduler",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "queue": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "runPersonalBriefing",
            "args": {
              "action": "enqueue"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Queue due personal briefings"
          }
        }
      }
    ]
  },
  "name": "ALICE personal briefing scheduler"
}