{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_ase_update",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "start_portfolio_update": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageASE",
            "args": {
              "action": "automationStart",
              "confirmed": true,
              "scheduled": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Resume or start overnight ASE update",
            "description": "Saved position; check new Companies House accounts"
          }
        }
      }
    ]
  },
  "description": "At 21:15 Europe/London each night, resumes the unfinished portfolio cycle at its saved company and source, or starts a new cycle only after completion. Checks Companies House for new filed accounts and extracts the latest disclosed turnover, reusing integrity-checked unchanged filings. Scheduled collection pauses at 07:00 and continues the next night; manually paused runs stay paused. Demos and HMRC are excluded, legacy assessments are preserved, and live work is not duplicated.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "15 21 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Nightly ASE Update"
}