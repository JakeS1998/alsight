{
  "name": "Nightly ASE Update",
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_ase_update",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "start_portfolio_update": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageASE",
            "args": {
              "action": "automationStart",
              "confirmed": true,
              "scheduled": true
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Start overnight ASE v2 update",
            "description": "Gazette overnight; all supported live organisations"
          }
        }
      }
    ]
  },
  "description": "At 21:15 Europe/London each night, starts the resumable ASE v2 portfolio update, including overnight Gazette checks for supported live organisations. Gazette collection stops outside 21:00\u201307:00; daytime updates continue with current cached evidence or explicit limitations. Demos and HMRC are excluded, historical legacy assessments are preserved, and active ASE work is not duplicated.",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "15 21 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  }
}