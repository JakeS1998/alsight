{
  "description": "At 21:15 Europe/London, starts or resumes the overnight all-source Compass portfolio refresh. Refreshes Companies House registry and filed accounts, Gazette, council, Environment Agency and automated Leadership & Control sources where applicable, then republishes using the latest saved profile and internal evidence. Stops at 07:00 and resumes saved organisation/source progress the next night; manual pauses, provider limits, evidence safeguards and assessment history are preserved. Active runs are never overlapped.",
  "name": "Nightly ASE Update",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "15 21 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_ase_update",
      "version": "1.4",
      "namespace": "base44"
    },
    "do": [
      {
        "start_portfolio_update": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageASE",
            "args": {
              "action": "automationStart",
              "confirmed": true,
              "scheduled": true,
              "sourceMode": "assessment"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Resume or start overnight all-source Compass refresh",
            "description": "Applicable sources, latest profiles and automatic publication"
          }
        }
      }
    ]
  }
}