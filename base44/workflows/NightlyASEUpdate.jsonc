{
  "description": "At 21:15 Europe/London, starts or resumes a separate Gazette-only company refresh. Companies House and council source assessments continue independently during the daytime. Gazette collection stops at 07:00 and resumes from saved progress the next night; manual pauses, provider limits, existing evidence freshness and legacy assessments are preserved.",
  "name": "Nightly ASE Update",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "15 21 * * *",
      "one_time_date": null,
      "timezone": "Europe/London",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "nightly_ase_update",
      "version": "1.3",
      "namespace": "base44"
    },
    "do": [
      {
        "start_portfolio_update": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageASE",
            "args": {
              "action": "automationStart",
              "confirmed": true,
              "scheduled": true,
              "sourceMode": "gazette"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Resume or start Gazette-only refresh",
            "description": "Stored progress; no daytime source refreshes"
          }
        }
      }
    ]
  }
}