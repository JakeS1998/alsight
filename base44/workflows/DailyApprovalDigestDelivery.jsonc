{
  "name": "Daily Approval Reminder Email",
  "description": "Prepares each registered approval user's private digest, sends the existing ALSight template through the backend email service, and records successful sending without repeating completed deliveries.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ApprovalDigestDelivery",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"queued\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_approval_reminder_email",
      "version": "1.1",
      "namespace": "base44"
    },
    "do": [
      {
        "prepare": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageDailyApprovalDigest",
            "args": {
              "action": "digest",
              "deliveryId": "${ .trigger.entity_id }"
            }
          },
          "then": "check_inbox",
          "x-base44": {
            "title": "Prepare this user's approvals",
            "description": "Verify access and current outstanding records"
          }
        }
      },
      {
        "check_inbox": {
          "switch": [
            {
              "when": "${ .prepare.send == true }",
              "then": "email_summary"
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Any approvals awaiting a decision?",
            "description": "Skip revoked access or empty inboxes"
          }
        }
      },
      {
        "email_summary": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageDailyApprovalDigest",
            "args": {
              "action": "deliver",
              "deliveryId": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Send and record approval summary",
            "description": "Recheck eligibility, claim delivery, send the ALSight template and record success"
          }
        }
      }
    ]
  }
}