{
  "name": "Daily Approval Reminder Email",
  "description": "Checks each recipient\u2019s pending Microsoft approvals and sends a private ALS Hub digest only if something needs their decision.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "ApprovalDigestDelivery",
      "events": [
        "create"
      ]
    },
    "condition": "${ .trigger.data.status == \"queued\" }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_approval_reminder_email",
      "version": "1.2",
      "namespace": "base44"
    },
    "do": [
      {
        "prepare": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageDailyApprovalDigest",
            "args": {
              "action": "digest",
              "deliveryId": "${ .trigger.entity_id }"
            }
          },
          "then": "check_inbox",
          "x-base44": {
            "title": "Prepare this user\u2019s approvals",
            "description": "Verify Microsoft identity and pending assignments"
          }
        }
      },
      {
        "check_inbox": {
          "switch": [
            {
              "when": "${ .prepare.send == true }",
              "then": "email_summary",
              "x-base44": {
                "title": "Has eligible pending approvals"
              }
            },
            {
              "when": "${ true }",
              "then": "end"
            }
          ],
          "x-base44": {
            "title": "Any approvals awaiting a decision?",
            "description": "Skip empty or inaccessible inboxes"
          }
        }
      },
      {
        "email_summary": {
          "call": "send_email",
          "with": {
            "template_name": "DailyApprovalDigest",
            "to": "${ .prepare.to }",
            "category": "transactional",
            "description": "Lists the recipient\u2019s outstanding Microsoft approvals and due dates",
            "variables": {
              "summary": "${ .prepare.variables.summary }",
              "approval_items": "${ .prepare.variables.approval_items }",
              "more": "${ .prepare.variables.more }",
              "approval_url": "${ .prepare.variables.approval_url }"
            }
          },
          "then": "record_result",
          "x-base44": {
            "title": "Send approval summary"
          }
        }
      },
      {
        "record_result": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "manageDailyApprovalDigest",
            "args": {
              "action": "record",
              "deliveryId": "${ .trigger.entity_id }",
              "sent": "${ .email_summary.sent == true }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Record email outcome"
          }
        }
      }
    ]
  }
}