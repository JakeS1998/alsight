{
  "name": "Sequential Risk Approval Invitations",
  "description": "Emails the current registered recipient when a risk-register issue starts or advances after acceptance.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "RiskApprovalPacket",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"active\" and .trigger.data.notification_status == \"pending\" and (.trigger.event_type == \"create\" or .trigger.old_data.current_index != .trigger.data.current_index or .trigger.old_data.notification_status != \"pending\") }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "sequential_risk_approval_invitations",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "send_invitation": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendRiskApprovalInvite",
            "args": {
              "packet_id": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Invite next registered recipient",
            "description": "Send the next acceptance invitation"
          }
        }
      }
    ]
  }
}