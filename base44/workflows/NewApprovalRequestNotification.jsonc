{
  "name": "New Approval Request Email",
  "description": "Emails each registered assigned approver with a summary and review link when a new live approval is ready. Routine sync updates do not resend it.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "DocumentApprovalRequest",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"pending\" and .trigger.data.source_requires_approval != false and (.trigger.data.response // \"\") == \"\" and .trigger.data.routing_assigned == true and (.trigger.data.approver_email // \"\") != \"\" and ((.trigger.data.request_key // \"\") | startswith(\"live:\")) and .trigger.data.writeback_status == \"pending\" and (.trigger.event_type == \"create\" or .trigger.old_data.writeback_status == \"not_required\") }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_approval_request_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_approver": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "sendApprovalRequestNotification",
            "args": {
              "requestId": "${ .trigger.entity_id }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify assigned approver",
            "description": "New request summary and review link"
          }
        }
      }
    ]
  }
}