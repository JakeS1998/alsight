{
  "name": "New Approval Request Email",
  "description": "Emails each registered assigned approver with a summary and review link when a new live approval is ready. Routine sync updates do not resend it.",
  "trigger": {
    "config": {
      "trigger_type": "entity",
      "entity_name": "DocumentApprovalRequest",
      "events": [
        "create",
        "update"
      ]
    },
    "condition": "${ .trigger.data.status == \"pending\" and .trigger.data.source_requires_approval != false and (.trigger.data.response // \"\") == \"\" and .trigger.data.routing_assigned == true and (.trigger.data.approver_email // \"\") != \"\" and ((.trigger.data.request_key // \"\") | startswith(\"live:\")) and .trigger.data.writeback_status == \"pending\" and (.trigger.event_type == \"create\" or .trigger.old_data.writeback_status == \"not_required\") }"
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "new_approval_request_email",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "notify_approver": {
          "call": "send_email",
          "with": {
            "template_name": "NewApprovalRequest",
            "to": "${ .trigger.data.approver_email }",
            "description": "Summarises the assigned document, project, requester and reason, with a direct approval review link.",
            "variables": {
              "document_title": "${ (.trigger.data.document_title // \"Approval document\") | gsub(\"\u2014\"; \",\") | gsub(\"&\"; \"&amp;\") | gsub(\"<\"; \"&lt;\") | gsub(\">\"; \"&gt;\") }",
              "document_number": "${ (.trigger.data.document_number // \"\") | if length == 0 then \"Not recorded\" else . end | gsub(\"&\"; \"&amp;\") | gsub(\"<\"; \"&lt;\") | gsub(\">\"; \"&gt;\") }",
              "approval_type": "${ if .trigger.data.source_table == \"dma\" then \"Development agreement\" elif .trigger.data.source_table == \"warranties\" then \"Warranty\" else \"Legal document\" end }",
              "project_name": "${ (.trigger.data.project_name // \"Project not recorded\") | gsub(\"&\"; \"&amp;\") | gsub(\"<\"; \"&lt;\") | gsub(\">\"; \"&gt;\") }",
              "project_number": "${ (.trigger.data.project_number // \"\") | if length == 0 then \"Not recorded\" else . end | gsub(\"&\"; \"&amp;\") | gsub(\"<\"; \"&lt;\") | gsub(\">\"; \"&gt;\") }",
              "client_name": "${ (.trigger.data.client_name // \"\") | if length == 0 then \"Not recorded\" else . end | gsub(\"&\"; \"&amp;\") | gsub(\"<\"; \"&lt;\") | gsub(\">\"; \"&gt;\") }",
              "requester_name": "${ (.trigger.data.requested_by_name // \"\") | if length == 0 then \"Approval routing\" else . end | gsub(\"&\"; \"&amp;\") | gsub(\"<\"; \"&lt;\") | gsub(\">\"; \"&gt;\") }",
              "requested_at": "${ .trigger.data.requested_at // \"Not recorded\" }",
              "reason": "${ (.trigger.data.reason // \"\") | if length == 0 then \"Please review the document and record your decision.\" else . end | gsub(\"\u2014\"; \",\") | gsub(\"&\"; \"&amp;\") | gsub(\"<\"; \"&lt;\") | gsub(\">\"; \"&gt;\") }",
              "approval_url": "${ \"https://alsight.base44.app/approvals?approval=\" + (.trigger.entity_id | @uri) }"
            }
          },
          "then": "end",
          "x-base44": {
            "title": "Notify assigned approver",
            "description": "New request summary and review link"
          }
        }
      }
    ]
  }
}