{
  "name": "FrameworkWideKpi",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "enum": [
        "primary"
      ]
    },
    "management_information_on_time": {
      "type": "string",
      "enum": [
        "",
        "Y",
        "N"
      ],
      "default": ""
    },
    "supplier_insurance_confirmed": {
      "type": "string",
      "enum": [
        "",
        "Y",
        "N"
      ],
      "default": ""
    },
    "supplier_questionnaire_current": {
      "type": "string",
      "enum": [
        "",
        "Y",
        "N"
      ],
      "default": ""
    },
    "schedule14_insurance_confirmed": {
      "type": "string",
      "enum": [
        "",
        "Y",
        "N"
      ],
      "default": ""
    },
    "high_level_review_date": {
      "type": "string",
      "maxLength": 10,
      "pattern": "^$|^\\d{4}-\\d{2}-\\d{2}$"
    },
    "high_level_evidence": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "required": [
    "key"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "framework_stakeholder"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}