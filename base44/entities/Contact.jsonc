{
  "name": "Contact",
  "type": "object",
  "properties": {
    "full_name": {
      "type": "string"
    },
    "first_name": {
      "type": "string"
    },
    "last_name": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "email2": {
      "type": "string",
      "format": "email"
    },
    "email3": {
      "type": "string",
      "format": "email"
    },
    "job_title": {
      "type": "string"
    },
    "company_name": {
      "type": "string",
      "description": "Companies House company name snapshot"
    },
    "company_number": {
      "type": "string"
    },
    "company_logo_uri": {
      "type": "string",
      "description": "Private file URI for the company logo (used in valuation PDF exports)"
    },
    "department": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "mobile_phone": {
      "type": "string"
    },
    "address_line1": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_county": {
      "type": "string"
    },
    "address_postcode": {
      "type": "string"
    },
    "address_country": {
      "type": "string"
    },
    "officer_first_name": {
      "type": "string"
    },
    "officer_last_name": {
      "type": "string"
    },
    "officer_full_name": {
      "type": "string"
    },
    "officer_role": {
      "type": "string"
    },
    "ch_person_number": {
      "type": "string"
    },
    "officer_appointments_link": {
      "type": "string"
    },
    "nationality": {
      "type": "string"
    },
    "appointed_on": {
      "type": "string",
      "format": "date-time"
    },
    "identify_verified": {
      "type": "boolean"
    },
    "system_managed": {
      "type": "boolean"
    },
    "position": {
      "type": "string"
    },
    "authority": {
      "type": "string"
    },
    "aad_id": {
      "type": "string",
      "description": "Portal user id linked to this contact"
    },
    "portal_role": {
      "type": "string",
      "description": "Portal role of the linked user"
    },
    "managing_partner_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "dataverse_id": {
      "type": "string",
      "description": "Original Dataverse contactid GUID"
    }
  },
  "required": [
    "full_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "$and": [
            {
              "data.aad_id": "{{user.id}}"
            },
            {
              "data.aad_id": {
                "$ne": null
              }
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}