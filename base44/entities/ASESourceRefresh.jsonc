{
  "name": "ASESourceRefresh",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "source_key": {
      "type": "string",
      "enum": [
        "blackflag",
        "gazette",
        "hmrc",
        "local_authority"
      ]
    },
    "identifier": {
      "type": "string"
    },
    "requested_by": {
      "type": "string"
    },
    "refreshed_at": {
      "type": "string",
      "format": "date-time"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "partial",
        "failed"
      ]
    },
    "summary": {
      "type": "object",
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "error": {
      "type": "string",
      "maxLength": 1000
    },
    "raw_file_uri": {
      "type": "string"
    },
    "raw_sha256": {
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "source_key",
    "identifier",
    "requested_by",
    "refreshed_at",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}