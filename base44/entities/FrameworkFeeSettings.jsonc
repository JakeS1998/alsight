{
  "name": "FrameworkFeeSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "description": "Singleton key, e.g. 'uklf-fee-bands'"
    },
    "bands": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "properties": {
          "min": {
            "type": "number",
            "minimum": 0,
            "description": "Lower bound of the contract value band (GBP)"
          },
          "max": {
            "type": "number",
            "minimum": 0,
            "description": "Upper bound of the contract value band (GBP). Use 0 or omit for the open-ended top band."
          },
          "pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100,
            "description": "Framework fee percentage applied to the contract value within this band"
          }
        },
        "required": [
          "min",
          "pct"
        ]
      },
      "default": []
    },
    "contingency_label": {
      "type": "string",
      "default": "Contingency",
      "description": "Description text used to identify contingency lines excluded from the contract value"
    },
    "uklf_label": {
      "type": "string",
      "default": "UKLF Fee",
      "description": "Description text used to identify the UKLF framework fee line"
    },
    "updated_by": {
      "type": "string"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key",
    "bands"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}