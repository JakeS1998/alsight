{
  "name": "Valuation",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "project_manager_contact_id": {
      "type": "string"
    },
    "bdm_aad_id": {
      "type": "string"
    },
    "bsm_aad_id": {
      "type": "string"
    },
    "department_id": {
      "type": "string"
    },
    "number": {
      "type": "integer"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted",
        "under_review",
        "returned",
        "approved",
        "rejected",
        "paid"
      ]
    },
    "period_start": {
      "type": "string",
      "format": "date"
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "valuation_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "deductions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "comments": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "audit": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_by": {
      "type": "string"
    },
    "submitted_by_name": {
      "type": "string"
    },
    "reviewer_name": {
      "type": "string"
    },
    "review_comments": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_gross": {
      "type": "number"
    },
    "approved_retention": {
      "type": "number"
    },
    "approved_deductions": {
      "type": "number"
    },
    "approved_net": {
      "type": "number"
    },
    "retention_percent": {
      "type": "number"
    },
    "payment_status": {
      "type": "string",
      "enum": [
        "awaiting_invoice",
        "invoice_received",
        "approved_for_payment",
        "scheduled",
        "paid",
        "on_hold"
      ]
    },
    "payment_due_date": {
      "type": "string",
      "format": "date"
    },
    "payment_reference": {
      "type": "string"
    },
    "invoice_number": {
      "type": "string"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "payment_date": {
      "type": "string",
      "format": "date"
    },
    "amount_paid": {
      "type": "number"
    },
    "payment_notes": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "number",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "$and": [
            {
              "user_condition": {
                "role": "project_manager"
              }
            },
            {
              "data.project_manager_contact_id": "{{user.data.contact_dataverse_id}}"
            }
          ]
        },
        {
          "data.bdm_aad_id": "{{user.id}}"
        },
        {
          "data.bsm_aad_id": "{{user.id}}"
        },
        {
          "data.department_id": "{{user.data.region}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}