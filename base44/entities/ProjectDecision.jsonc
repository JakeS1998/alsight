{
  "name": "ProjectDecision",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Base44 id of parent project"
    },
    "client_account_id": {
      "type": "string",
      "description": "Backfilled from project for RLS"
    },
    "bdm_aad_id": {
      "type": "string",
      "description": "Backfilled from project for RLS"
    },
    "decision_title": {
      "type": "string"
    },
    "requested_by": {
      "type": "string"
    },
    "date_requested": {
      "type": "string",
      "format": "date"
    },
    "required_by": {
      "type": "string",
      "format": "date"
    },
    "decision_maker": {
      "type": "string"
    },
    "decision": {
      "type": "string"
    },
    "date_agreed": {
      "type": "string",
      "format": "date"
    },
    "financial_impact": {
      "type": "string"
    },
    "financial_adjustment": {
      "type": "number",
      "default": 0,
      "description": "Net contract adjustment in GBP: positive for additions, negative for omissions. Only agreed decisions affect valuation contract totals."
    },
    "programme_impact": {
      "type": "string"
    },
    "supporting_document": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "agreed"
      ],
      "default": "open"
    }
  },
  "required": [
    "project_id",
    "decision_title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_account_id": "{{user.data.account_id}}"
        },
        {
          "data.bdm_aad_id": "{{user.id}}"
        },
        {
          "data.bdm_aad_id": "{{user.data.delegate_of}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    }
  }
}