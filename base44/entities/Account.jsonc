{
  "name": "Account",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "account_type": {
      "type": "string",
      "enum": [
        "client",
        "supplier"
      ],
      "description": "760820000=client, 760820001=supplier"
    },
    "company_number": {
      "type": "string",
      "description": "Companies House registration number"
    },
    "company_name": {
      "type": "string",
      "description": "Companies House registered name"
    },
    "company_status": {
      "type": "string",
      "description": "active, dissolved, etc."
    },
    "company_type": {
      "type": "string",
      "description": "ltd, plc, etc."
    },
    "date_of_incorporation": {
      "type": "string",
      "format": "date-time"
    },
    "uklf_approved": {
      "type": "boolean",
      "default": false
    },
    "address_line1": {
      "type": "string"
    },
    "address_line2": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_county": {
      "type": "string"
    },
    "address_postcode": {
      "type": "string"
    },
    "address_country": {
      "type": "string"
    },
    "sharepoint_folder": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "phone": {
      "type": "string"
    },
    "website": {
      "type": "string"
    },
    "ch_links_self": {
      "type": "string"
    },
    "ch_links_officers": {
      "type": "string"
    },
    "ch_links_filing_history": {
      "type": "string"
    },
    "ch_links_psc": {
      "type": "string"
    },
    "sqq_expiry": {
      "type": "string",
      "format": "date"
    },
    "comments": {
      "type": "string"
    },
    "assigned_bsm_aad_id": {
      "type": "string"
    },
    "account_manager_aad_id": {
      "type": "string"
    },
    "parent_account_id": {
      "type": "string"
    },
    "primary_contact_id": {
      "type": "string"
    },
    "linked_user_id": {
      "type": "string",
      "description": "Portal user linked to this account (for RLS)"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "dataverse_id": {
      "type": "string",
      "description": "Original Dataverse accountid GUID"
    }
  },
  "required": [
    "name",
    "account_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.linked_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "client"
          }
        },
        {
          "user_condition": {
            "role": "supplier"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.linked_user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}