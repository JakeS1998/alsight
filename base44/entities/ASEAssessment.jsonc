{
  "name": "ASEAssessment",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "organisation_type": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "enum": [
        "company",
        "english_local_authority"
      ]
    },
    "precise_score": {
      "type": "number"
    },
    "displayed_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "rating_label": {
      "type": "string"
    },
    "previous_rating": {
      "type": "integer"
    },
    "previous_assessment_id": {
      "type": "string"
    },
    "change": {
      "type": "integer"
    },
    "assessment_date": {
      "type": "string",
      "format": "date-time"
    },
    "data_confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "confidence_explanation": {
      "type": "string"
    },
    "coverage": {
      "type": "number"
    },
    "explanation": {
      "type": "string"
    },
    "policy_version": {
      "type": "string"
    },
    "policy_snapshot": {
      "type": "object",
      "additionalProperties": true
    },
    "commercial_context": {
      "type": "object",
      "additionalProperties": true,
      "description": "Bounded frozen non-scoring commercial comparison, source provenance and contract input context"
    },
    "status": {
      "type": "string",
      "enum": [
        "building",
        "published"
      ]
    },
    "is_demo": {
      "type": "boolean"
    },
    "published_by_id": {
      "type": "string"
    },
    "published_by_name": {
      "type": "string"
    },
    "reviewed_at": {
      "type": "string",
      "format": "date-time"
    },
    "publication_note": {
      "type": "string",
      "maxLength": 1000
    },
    "snapshot_evidence_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "selected_evidence_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 100
    },
    "publication_mode": {
      "type": "string",
      "enum": [
        "manual",
        "automatic"
      ]
    },
    "automation_key": {
      "type": "string"
    },
    "automation_run_id": {
      "type": "string"
    },
    "evidence_manifest_uri": {
      "type": "string"
    },
    "evidence_manifest_sha256": {
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "organisation_type",
    "model",
    "assessment_date",
    "data_confidence",
    "policy_version",
    "policy_snapshot",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.status": "building"
        }
      ]
    },
    "delete": false
  }
}