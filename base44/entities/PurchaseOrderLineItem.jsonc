{
  "name": "PurchaseOrderLineItem",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "net_value": {
      "type": "number"
    },
    "gross_value": {
      "type": "number"
    },
    "vat_value": {
      "type": "number"
    },
    "vat": {
      "type": "string"
    },
    "riba_stage": {
      "type": "string"
    },
    "cost_center_id": {
      "type": "string",
      "description": "GLCode dataverse_id"
    },
    "po_id": {
      "type": "string",
      "description": "PurchaseOrder dataverse_id"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "dataverse_id": {
      "type": "string",
      "description": "Original cr78c_purchase_order_line_itemid GUID"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}