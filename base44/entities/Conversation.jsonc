{
  "name": "Conversation",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "channel": {
      "type": "string",
      "enum": [
        "call",
        "meeting",
        "email",
        "other"
      ]
    },
    "summary": {
      "type": "string"
    },
    "next_step": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "line_manager_id": {
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "contact_id",
    "occurred_at",
    "summary"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.line_manager_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "data.owner_id": "{{user.id}}"
            },
            {
              "data.line_manager_id": "{{user.id}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "data.owner_id": "{{user.id}}"
            },
            {
              "data.line_manager_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}