{
  "name": "ASEV2OrganisationInput",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "input_type": {
      "type": "string",
      "enum": [
        "turnover",
        "experience"
      ]
    },
    "turnover_value": {
      "type": "number",
      "minimum": 0
    },
    "period_end": {
      "type": "string",
      "format": "date"
    },
    "obtained_at": {
      "type": "string",
      "format": "date"
    },
    "evidence_reference": {
      "type": "string",
      "maxLength": 500
    },
    "evidence_origin": {
      "type": "string",
      "enum": [
        "declared",
        "internal",
        "external"
      ]
    },
    "outcome": {
      "type": "string",
      "enum": [
        "excellent",
        "satisfactory",
        "resolved_issue",
        "unresolved_material",
        "serious_unresolved"
      ]
    },
    "event_date": {
      "type": "string",
      "format": "date"
    },
    "project_id": {
      "type": "string"
    },
    "verified_by": {
      "type": "string"
    },
    "verification_note": {
      "type": "string",
      "maxLength": 600
    }
  },
  "required": [
    "account_id",
    "input_type",
    "evidence_reference",
    "verified_by"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "ase_snapshot_maintenance"
      }
    },
    "delete": false
  }
}