{
  "name": "ApprovalRouting",
  "type": "object",
  "properties": {
    "table": {
      "type": "string",
      "enum": [
        "documents",
        "dma",
        "warranties"
      ]
    },
    "named_emails": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "format": "email"
      }
    },
    "related_rules": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "enum": [
          "project_bsm",
          "project_bdm",
          "project_director",
          "document_bsm",
          "project_manager",
          "client_rep",
          "client_rep2",
          "contractor_contact"
        ]
      }
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "changed_by": {
      "type": "string"
    },
    "changed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "table",
    "named_emails",
    "related_rules",
    "enabled"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}