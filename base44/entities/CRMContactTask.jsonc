{
  "name": "CRMContactTask",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "due_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_id": {
      "type": "string"
    },
    "line_manager_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "done"
      ],
      "default": "open"
    }
  },
  "required": [
    "contact_id",
    "title",
    "owner_id",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.line_manager_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "data.owner_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}