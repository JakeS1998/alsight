{
  "name": "DataverseUserConnection",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "environment_url": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "connected",
        "disconnected"
      ]
    },
    "encrypted_payload": {
      "type": "string",
      "maxLength": 30000
    },
    "organisation_id": {
      "type": "string"
    },
    "dataverse_user_id": {
      "type": "string"
    },
    "last_checked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "environment_url",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}