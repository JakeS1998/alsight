{
  "name": "ProjectRisk",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Base44 id of parent project"
    },
    "client_account_id": {
      "type": "string",
      "description": "Backfilled from project for RLS"
    },
    "bdm_aad_id": {
      "type": "string",
      "description": "Backfilled from project for RLS"
    },
    "title": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "probability": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        ""
      ],
      "default": ""
    },
    "impact": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        ""
      ],
      "default": ""
    },
    "owner": {
      "type": "string"
    },
    "mitigation": {
      "type": "string"
    },
    "target_resolution": {
      "type": "string",
      "format": "date"
    },
    "rag": {
      "type": "string",
      "enum": [
        "red",
        "amber",
        "green",
        ""
      ],
      "default": ""
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "closed"
      ],
      "default": "open"
    },
    "reference": {
      "type": "string"
    },
    "cause": {
      "type": "string"
    },
    "impact_description": {
      "type": "string"
    },
    "probability_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "impact_rating": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },
    "risk_index": {
      "type": "integer",
      "minimum": 1,
      "maximum": 25
    },
    "anticipated_cost": {
      "type": "number",
      "minimum": 0
    },
    "weighted_cost": {
      "type": "number",
      "minimum": 0
    },
    "comments": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_account_id": "{{user.data.account_id}}"
        },
        {
          "data.bdm_aad_id": "{{user.id}}"
        },
        {
          "data.bdm_aad_id": "{{user.data.delegate_of}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    }
  }
}