{
  "name": "ProjectAction",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Base44 id of parent project"
    },
    "client_account_id": {
      "type": "string",
      "description": "Backfilled from project for RLS"
    },
    "bdm_aad_id": {
      "type": "string",
      "description": "Backfilled from project for RLS"
    },
    "action": {
      "type": "string"
    },
    "owner": {
      "type": "string"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "in_progress",
        "done"
      ],
      "default": "open"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high"
      ],
      "default": "medium"
    },
    "comments": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "action"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_account_id": "{{user.data.account_id}}"
        },
        {
          "data.bdm_aad_id": "{{user.id}}"
        },
        {
          "data.bdm_aad_id": "{{user.data.delegate_of}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    }
  }
}