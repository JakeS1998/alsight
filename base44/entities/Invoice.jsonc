{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Base44 project ID"
    },
    "invoice_number": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "paid_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "paid"
      ],
      "default": "issued"
    },
    "sample": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "project_id",
    "invoice_number",
    "amount",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}