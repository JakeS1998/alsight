{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "invoice_number": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "project_name": {
      "type": "string"
    },
    "client_account_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "supplier_account_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "amount": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "paid",
        "overdue"
      ],
      "default": "draft"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "file_url": {
      "type": "string",
      "description": "PDF copy of the invoice"
    },
    "file_name": {
      "type": "string"
    }
  },
  "required": [
    "invoice_number"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.client_account_id": "{{user.data.account_id}}"
        },
        {
          "data.supplier_account_id": "{{user.data.account_id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "company_director"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}