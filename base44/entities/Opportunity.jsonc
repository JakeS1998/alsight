{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "project_details": {
      "type": "string"
    },
    "budget": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "lost",
        "won"
      ],
      "default": "open"
    },
    "project_id": {
      "type": "string"
    },
    "lost_reason": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "line_manager_id": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "stage": {
      "type": "string",
      "enum": [
        "lead",
        "qualified",
        "scope_development",
        "design_feasibility",
        "proposal_preparation",
        "proposal_submitted",
        "negotiation",
        "preferred_partner",
        "won",
        "lost",
        "on_hold"
      ],
      "default": "lead"
    },
    "stage_entered_at": {
      "type": "string"
    },
    "probability": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "expected_decision_date": {
      "type": "string"
    },
    "alliance_fee": {
      "type": "number"
    },
    "weighted_value": {
      "type": "number"
    },
    "weighted_alliance_fee": {
      "type": "number"
    },
    "expected_project_start": {
      "type": "string"
    },
    "won_date": {
      "type": "string"
    },
    "confirmed_project_value": {
      "type": "number"
    },
    "confirmed_alliance_fee": {
      "type": "number"
    },
    "award_details": {
      "type": "string"
    },
    "lost_date": {
      "type": "string"
    },
    "lost_competitor": {
      "type": "string"
    },
    "lost_notes": {
      "type": "string"
    },
    "site_postcode": {
      "type": "string"
    },
    "scope_summary": {
      "type": "string"
    },
    "client_objectives": {
      "type": "string"
    },
    "initial_constraints": {
      "type": "string"
    },
    "target_programme": {
      "type": "string"
    },
    "key_stakeholders": {
      "type": "string"
    },
    "funding_route": {
      "type": "string"
    },
    "design_team": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fee_basis": {
      "type": "string",
      "enum": [
        "fixed",
        "percentage",
        "day_rate",
        ""
      ]
    },
    "fee_status": {
      "type": "string",
      "enum": [
        "draft",
        "internal_review",
        "sent",
        "negotiation",
        "accepted",
        "lost",
        ""
      ]
    },
    "fee_services_included": {
      "type": "string"
    },
    "fee_services_excluded": {
      "type": "string"
    },
    "fee_consultants_required": {
      "type": "string"
    },
    "fee_lines": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fee_issued_date": {
      "type": "string"
    },
    "fee_client_approval_date": {
      "type": "string"
    },
    "fee_link_to_file": {
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.line_manager_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "$or": [
            {
              "data.owner_id": "{{user.id}}"
            },
            {
              "data.line_manager_id": "{{user.id}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "data.owner_id": "{{user.id}}"
            },
            {
              "data.line_manager_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}