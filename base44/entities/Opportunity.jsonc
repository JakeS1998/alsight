{
  "name": "Opportunity",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "project_details": {
      "type": "string"
    },
    "budget": {
      "type": "number"
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "lost",
        "won"
      ],
      "default": "open"
    },
    "project_id": {
      "type": "string"
    },
    "lost_reason": {
      "type": "string"
    },
    "site_postcode": {
      "type": "string"
    },
    "scope_summary": {
      "type": "string"
    },
    "client_objectives": {
      "type": "string"
    },
    "initial_constraints": {
      "type": "string"
    },
    "target_programme": {
      "type": "string"
    },
    "key_stakeholders": {
      "type": "string"
    },
    "funding_route": {
      "type": "string"
    },
    "design_team": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fee_basis": {
      "type": "string",
      "enum": [
        "fixed",
        "percentage",
        "day_rate",
        ""
      ]
    },
    "fee_status": {
      "type": "string",
      "enum": [
        "draft",
        "internal_review",
        "sent",
        "negotiation",
        "accepted",
        "lost",
        ""
      ]
    },
    "fee_services_included": {
      "type": "string"
    },
    "fee_services_excluded": {
      "type": "string"
    },
    "fee_consultants_required": {
      "type": "string"
    },
    "fee_lines": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "fee_issued_date": {
      "type": "string"
    },
    "fee_client_approval_date": {
      "type": "string"
    },
    "fee_link_to_file": {
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}