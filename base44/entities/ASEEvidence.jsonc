{
  "name": "ASEEvidence",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "assessment_id": {
      "type": "string"
    },
    "component": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "maxLength": 200
    },
    "evidence_type": {
      "type": "string",
      "enum": [
        "financial",
        "compliance",
        "event",
        "governance"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "value": {
      "type": "string",
      "maxLength": 200
    },
    "previous_value": {
      "type": "string",
      "maxLength": 200
    },
    "reporting_period": {
      "type": "string",
      "format": "date"
    },
    "source_date": {
      "type": "string",
      "format": "date"
    },
    "retrieval_date": {
      "type": "string",
      "format": "date-time"
    },
    "severity": {
      "type": "string",
      "enum": [
        "none",
        "minor",
        "moderate",
        "material",
        "serious"
      ]
    },
    "confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "source_reference": {
      "type": "string",
      "maxLength": 1000
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    },
    "currency": {
      "type": "string",
      "enum": [
        "GBP"
      ]
    },
    "period_months": {
      "type": "integer",
      "minimum": 1,
      "maximum": 24
    },
    "is_demo": {
      "type": "boolean"
    },
    "external_key": {
      "type": "string"
    },
    "company_number": {
      "type": "string"
    },
    "raw_file_uri": {
      "type": "string"
    },
    "source_refresh_id": {
      "type": "string"
    },
    "score_eligible": {
      "type": "boolean",
      "default": true
    },
    "governance_review": {
      "type": "object",
      "properties": {
        "council_code": {
          "type": "string"
        },
        "identity_confirmed": {
          "type": "boolean"
        },
        "primary_document_checked": {
          "type": "boolean"
        },
        "primary_reference": {
          "type": "string",
          "maxLength": 1000
        },
        "document_status": {
          "type": "string",
          "enum": [
            "current",
            "resolved",
            "historic"
          ]
        },
        "audit_basis": {
          "type": "string",
          "enum": [
            "substantive",
            "mixed",
            "backstop_only",
            "not_applicable"
          ]
        },
        "operative_from": {
          "type": "string"
        },
        "operative_to": {
          "type": "string"
        },
        "material_findings_confirmed": {
          "type": "boolean"
        },
        "verified_by": {
          "type": "string"
        },
        "verified_name": {
          "type": "string"
        },
        "verified_at": {
          "type": "string",
          "format": "date-time"
        },
        "discovery_reference": {
          "type": "string",
          "maxLength": 1000
        }
      }
    }
  },
  "required": [
    "account_id",
    "component",
    "source",
    "evidence_type",
    "title",
    "value",
    "reporting_period",
    "source_date",
    "retrieval_date",
    "severity",
    "confidence",
    "source_reference"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "data.assessment_id": null
        }
      ]
    },
    "delete": false
  }
}