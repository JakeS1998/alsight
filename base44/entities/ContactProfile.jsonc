{
  "name": "ContactProfile",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string"
    },
    "birthday": {
      "type": "string"
    },
    "likes": {
      "type": "string"
    },
    "dislikes": {
      "type": "string"
    },
    "family_members": {
      "type": "string"
    },
    "relationship_notes": {
      "type": "string"
    },
    "preferred_name": {
      "type": "string"
    },
    "linkedin_url": {
      "type": "string"
    },
    "office_location": {
      "type": "string"
    },
    "alternative_email": {
      "type": "string"
    },
    "preferred_communication": {
      "type": "string"
    },
    "preferred_times": {
      "type": "string"
    },
    "relationship_status": {
      "type": "string",
      "enum": [
        "prospect",
        "new_relationship",
        "developing",
        "established",
        "strong",
        "dormant",
        "former_contact",
        ""
      ]
    },
    "relationship_strength": {
      "type": "string",
      "enum": [
        "new",
        "developing",
        "established",
        "strong",
        ""
      ]
    },
    "relationship_owner_contact_id": {
      "type": "string"
    },
    "known_since": {
      "type": "string"
    },
    "contact_priority": {
      "type": "string",
      "enum": [
        "standard",
        "important",
        "strategic",
        ""
      ]
    },
    "interests": {
      "type": "string"
    },
    "professional_priorities": {
      "type": "string"
    },
    "professional_challenges": {
      "type": "string"
    },
    "strategic_objectives": {
      "type": "string"
    },
    "personal_context": {
      "type": "string"
    }
  },
  "required": [
    "contact_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}