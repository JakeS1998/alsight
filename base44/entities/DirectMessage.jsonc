{
  "name": "DirectMessage",
  "type": "object",
  "properties": {
    "thread_key": {
      "type": "string"
    },
    "sender_id": {
      "type": "string"
    },
    "recipient_id": {
      "type": "string"
    },
    "body": {
      "type": "string",
      "maxLength": 4000
    },
    "is_read": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "thread_key",
    "sender_id",
    "recipient_id",
    "body",
    "is_read"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "regional_director"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.sender_id": "{{user.id}}"
            },
            {
              "data.recipient_id": "{{user.id}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}