{
  "name": "COVersion",
  "type": "object",
  "properties": {
    "dataset_id": {
      "type": "string"
    },
    "source_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "source_etag": {
      "type": "string"
    },
    "file_uri": {
      "type": "string"
    },
    "sha256": {
      "type": "string"
    },
    "file_size": {
      "type": "integer"
    },
    "copied_at": {
      "type": "string"
    }
  },
  "required": [
    "dataset_id",
    "source_id",
    "file_uri",
    "copied_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    },
    "update": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    },
    "delete": false
  }
}