{
  "name": "ASEV2Assessment",
  "type": "object",
  "properties": {
    "account_id": {
      "type": "string"
    },
    "methodology": {
      "type": "string",
      "enum": [
        "ASE v2"
      ]
    },
    "assessment_date": {
      "type": "string",
      "format": "date-time"
    },
    "policy_version": {
      "type": "string"
    },
    "policy_snapshot": {
      "type": "object",
      "additionalProperties": true
    },
    "raw_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "final_score": {
      "type": [
        "number",
        "null"
      ]
    },
    "classification": {
      "type": "string"
    },
    "confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium",
        "Low"
      ]
    },
    "coverage": {
      "type": "number",
      "minimum": 0,
      "maximum": 100
    },
    "assessed_weight": {
      "type": "number"
    },
    "components": {
      "type": "array",
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "caps": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": true
    },
    "experience": {
      "type": "object",
      "additionalProperties": true
    },
    "drivers": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "string"
      }
    },
    "explanation": {
      "type": "string",
      "maxLength": 10000
    },
    "previous_assessment_id": {
      "type": "string"
    },
    "legacy_assessment_id": {
      "type": "string"
    },
    "assessed_by": {
      "type": "string"
    },
    "assessment_note": {
      "type": "string"
    }
  },
  "required": [
    "account_id",
    "methodology",
    "assessment_date",
    "policy_version",
    "policy_snapshot",
    "classification",
    "confidence",
    "coverage",
    "components",
    "checks",
    "caps",
    "assessed_by"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "ase_snapshot_maintenance"
      }
    },
    "delete": false
  }
}