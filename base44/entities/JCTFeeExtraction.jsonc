{
  "name": "JCTFeeExtraction",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "linked_url": {
      "type": "string"
    },
    "source_url": {
      "type": "string"
    },
    "source_name": {
      "type": "string"
    },
    "source_etag": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "extracted",
        "unusable"
      ],
      "enumColors": [
        "green",
        "red"
      ]
    },
    "amount": {
      "type": [
        "number",
        "null"
      ]
    },
    "contractor": {
      "type": "string"
    },
    "vat_basis": {
      "type": "string"
    },
    "page": {
      "type": "integer"
    },
    "quote": {
      "type": "string",
      "maxLength": 2000
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "extracted_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "contract_id",
    "status",
    "extracted_at"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}