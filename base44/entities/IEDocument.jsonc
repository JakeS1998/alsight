{
  "name": "IEDocument",
  "type": "object",
  "properties": {
    "engagement_id": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "category": {
      "type": "string",
      "enum": [
        "research",
        "consultation",
        "creative",
        "finance",
        "other"
      ]
    },
    "file_uri": {
      "type": "string",
      "maxLength": 1000
    },
    "file_name": {
      "type": "string",
      "maxLength": 250
    },
    "file_size": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20971520
    },
    "uploaded_by": {
      "type": "string"
    },
    "uploaded_by_name": {
      "type": "string"
    }
  },
  "required": [
    "engagement_id",
    "title",
    "category",
    "file_uri",
    "file_name",
    "file_size"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}