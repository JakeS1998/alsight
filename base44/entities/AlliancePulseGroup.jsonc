{
  "name": "AlliancePulseGroup",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "maxLength": 100
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "owner_id": {
      "type": "string"
    },
    "member_ids": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "name",
    "owner_id",
    "member_ids"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.member_ids": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}