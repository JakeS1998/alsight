{
  "name": "InsuranceReportSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "enum": [
        "primary"
      ]
    },
    "enabled": {
      "type": "boolean",
      "default": false
    },
    "recipient_emails": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "format": "email"
      }
    },
    "changed_by": {
      "type": "string"
    },
    "changed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "key",
    "enabled",
    "recipient_emails"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}