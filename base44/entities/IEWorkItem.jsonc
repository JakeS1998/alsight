{
  "name": "IEWorkItem",
  "type": "object",
  "properties": {
    "engagement_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "research",
        "consultation",
        "creative"
      ]
    },
    "title": {
      "type": "string",
      "maxLength": 200
    },
    "work_type": {
      "type": "string",
      "maxLength": 100
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "in_progress",
        "complete"
      ],
      "default": "planned"
    },
    "owner_id": {
      "type": "string"
    },
    "owner_name": {
      "type": "string"
    },
    "due_date": {
      "type": "string"
    },
    "held_on": {
      "type": "string"
    },
    "audience": {
      "type": "string",
      "maxLength": 250
    },
    "attendees": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "stakeholders": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "survey_responses": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0
    },
    "notes": {
      "type": "string",
      "maxLength": 4000
    }
  },
  "required": [
    "engagement_id",
    "kind",
    "title",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}