{
  "name": "DocumentLinkCorrection",
  "type": "object",
  "properties": {
    "entity": {
      "type": "string",
      "enum": [
        "JCT",
        "DMA",
        "LegalDocument"
      ],
      "enumColors": [
        "blue",
        "purple",
        "gray"
      ]
    },
    "record_id": {
      "type": "string"
    },
    "url": {
      "type": "string",
      "maxLength": 2000
    },
    "original_url": {
      "type": "string",
      "maxLength": 2000
    },
    "changed_by": {
      "type": "string"
    }
  },
  "required": [
    "entity",
    "record_id",
    "url"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}