{
  "name": "ProjectCashFlow",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Base44 ID of the project"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "type": {
      "type": "string",
      "enum": [
        "received",
        "spent"
      ]
    },
    "amount": {
      "type": "number",
      "exclusiveMinimum": 0
    },
    "sample": {
      "type": "boolean",
      "default": false
    }
  },
  "required": [
    "project_id",
    "date",
    "type",
    "amount"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}