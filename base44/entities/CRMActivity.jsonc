{
  "name": "CRMActivity",
  "type": "object",
  "properties": {
    "opportunity_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "contact_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "line_manager_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "call",
        "email",
        "meeting",
        "teams_meeting",
        "client_visit",
        "internal_meeting",
        "note",
        "document_sent",
        "proposal_sent",
        "stage_change",
        "task_completed",
        "decision",
        "system"
      ]
    },
    "occurred_at": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "participants": {
      "type": "string"
    },
    "author_id": {
      "type": "string"
    },
    "author_name": {
      "type": "string"
    },
    "follow_up_date": {
      "type": "string"
    },
    "follow_up_owner_id": {
      "type": "string"
    }
  },
  "required": [
    "opportunity_id",
    "account_id",
    "type",
    "occurred_at",
    "subject"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.line_manager_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$and": [
        {
          "data.author_id": "{{user.id}}"
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "data.owner_id": "{{user.id}}"
            },
            {
              "data.line_manager_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "data.owner_id": "{{user.id}}"
            },
            {
              "data.line_manager_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}