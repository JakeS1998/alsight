{
  "name": "DMACheckJob",
  "type": "object",
  "properties": {
    "dma_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "reference": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "processing",
        "completed",
        "blocked"
      ],
      "enumColors": [
        "yellow",
        "blue",
        "green",
        "red"
      ]
    },
    "stage": {
      "type": "string"
    },
    "token": {
      "type": "string"
    },
    "claimed_at": {
      "type": "string"
    },
    "account_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 80
    },
    "account_index": {
      "type": "integer"
    },
    "extraction_status": {
      "type": "string"
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    },
    "results": {
      "type": "array",
      "maxItems": 80,
      "items": {
        "type": "object",
        "additionalProperties": true
      }
    }
  },
  "required": [
    "dma_id",
    "status",
    "token"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}