{
  "name": "CRMContactRelationship",
  "type": "object",
  "properties": {
    "contact_id": {
      "type": "string"
    },
    "staff_contact_id": {
      "type": "string"
    },
    "staff_name": {
      "type": "string"
    },
    "relationship_type": {
      "type": "string"
    },
    "strength": {
      "type": "string",
      "enum": [
        "new",
        "developing",
        "established",
        "strong"
      ]
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "contact_id",
    "staff_contact_id",
    "staff_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}