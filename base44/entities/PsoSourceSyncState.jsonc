{
  "name": "PsoSourceSyncState",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "enum": [
        "primary"
      ]
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "error"
      ]
    },
    "cursor": {
      "type": "string"
    },
    "dispatch_token": {
      "type": "string"
    },
    "lease_token": {
      "type": "string"
    },
    "lease_until": {
      "type": "string",
      "format": "date-time",
      "default": "1970-01-01T00:00:00.000Z"
    },
    "checked": {
      "type": "integer"
    },
    "failed": {
      "type": "integer"
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "completed_at": {
      "type": "string",
      "format": "date-time"
    },
    "error": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "key",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}