{
  "name": "UKLFDigestSettings",
  "type": "object",
  "properties": {
    "key": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean",
      "default": true
    },
    "selected_user_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50,
      "default": []
    },
    "last_run_at": {
      "type": "string",
      "format": "date-time"
    },
    "last_result": {
      "type": "string"
    }
  },
  "required": [
    "key",
    "enabled"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}