{
  "name": "IEClassification",
  "type": "object",
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "category",
        "support"
      ]
    },
    "name": {
      "type": "string",
      "maxLength": 150
    },
    "parent_id": {
      "type": "string"
    },
    "active": {
      "type": "boolean",
      "default": true
    },
    "provisional": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "kind",
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "sam"
          }
        },
        {
          "user_condition": {
            "role": "sam_director"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}