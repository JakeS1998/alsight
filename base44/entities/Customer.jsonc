{
  "name": "Customer",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "company_number": {
      "type": "string"
    },
    "account_code": {
      "type": "string",
      "description": "cr78c_ac e.g. C-00403"
    },
    "address_line1": {
      "type": "string"
    },
    "address_line2": {
      "type": "string"
    },
    "address_city": {
      "type": "string"
    },
    "address_postcode": {
      "type": "string"
    },
    "address_country": {
      "type": "string"
    },
    "contact_name": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "email": {
      "type": "string",
      "format": "email"
    },
    "vat_number": {
      "type": "string"
    },
    "department": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "dataverse_id": {
      "type": "string",
      "description": "Original cr78c_customersid GUID"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}