{
  "name": "CRMProjectLink",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "owner_id": {
      "type": "string"
    },
    "line_manager_id": {
      "type": "string"
    }
  },
  "required": [
    "project_id",
    "opportunity_id",
    "account_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.owner_id": "{{user.id}}"
        },
        {
          "data.line_manager_id": "{{user.id}}"
        }
      ]
    },
    "create": {
      "$and": [
        {
          "$or": [
            {
              "data.owner_id": "{{user.id}}"
            },
            {
              "data.line_manager_id": "{{user.id}}"
            }
          ]
        },
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            }
          ]
        }
      ]
    },
    "update": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "data.owner_id": "{{user.id}}"
            },
            {
              "data.line_manager_id": "{{user.id}}"
            }
          ]
        }
      ]
    },
    "delete": {
      "$and": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$or": [
            {
              "data.owner_id": "{{user.id}}"
            },
            {
              "data.line_manager_id": "{{user.id}}"
            }
          ]
        }
      ]
    }
  }
}