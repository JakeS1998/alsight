{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "company_director",
        "development_manager",
        "client",
        "supplier"
      ],
      "default": "client"
    },
    "account_id": {
      "type": "string",
      "description": "Account this user belongs to (set for client/supplier users)"
    },
    "phone": {
      "type": "string"
    }
  }
}