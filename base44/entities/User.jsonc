{
  "name": "User",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "admin",
        "director",
        "regional_director",
        "bsm",
        "finance",
        "bdm",
        "sam",
        "sam_director",
        "client",
        "supplier",
        "project_manager",
        "framework_stakeholder"
      ],
      "default": "client"
    },
    "duty_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "bsm",
          "bdm"
        ]
      },
      "maxItems": 2,
      "description": "Additional administrator-assigned operational roles. Does not replace the access role or independently grant data permissions.",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "page_access": {
      "type": "object",
      "description": "Administrator-managed page overrides. Missing keys follow role defaults; these settings never grant record or action permissions.",
      "additionalProperties": false,
      "properties": {
        "today": {
          "type": "boolean"
        },
        "alliance360": {
          "type": "boolean"
        },
        "network": {
          "type": "boolean"
        },
        "ie": {
          "type": "boolean"
        },
        "opportunities": {
          "type": "boolean"
        },
        "projects": {
          "type": "boolean"
        },
        "commercial": {
          "type": "boolean"
        },
        "approvals": {
          "type": "boolean"
        },
        "framework": {
          "type": "boolean"
        },
        "insider": {
          "type": "boolean"
        }
      },
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "account_id": {
      "type": "string",
      "description": "Dataverse GUID of account this user belongs to",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "company_number": {
      "type": "string",
      "description": "Company number of linked supplier account for supplier purchase orders",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "contact_dataverse_id": {
      "type": "string",
      "description": "Dataverse contact GUID for external project manager access",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "region": {
      "type": "string",
      "description": "Region GUID for regional director scoping",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "delegate_of": {
      "type": "string",
      "description": "User id covered via delegation",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "delegate_of_name": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "delegate_region": {
      "type": "string",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "staff_aad_id": {
      "type": "string",
      "description": "Original staff AAD identifier used by project assignments",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "dataverse_systemuser_id": {
      "type": "string",
      "description": "Reviewed Dataverse systemuser link; does not create a login or grant roles",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "phone": {
      "type": "string"
    },
    "line_manager_id": {
      "type": "string",
      "description": "Direct line manager's portal user ID; assigned by an administrator for pipeline visibility",
      "rls": {
        "update": {
          "user_condition": {
            "collaborator_role": "editor"
          }
        }
      }
    },
    "profile_picture_uri": {
      "type": "string",
      "maxLength": 500,
      "description": "Private storage URI for the user's profile picture"
    },
    "onboarding_step": {
      "type": "string",
      "enum": [
        "welcome",
        "details",
        "outlook",
        "teams",
        "dataverse",
        "complete"
      ]
    },
    "onboarding_completed_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}