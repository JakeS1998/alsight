{
  "name": "COMS",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "coms_rate": {
      "type": "string"
    },
    "comsrate": {
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "commission_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 100
    },
    "riba_stage": {
      "type": "string"
    },
    "project_ref": {
      "type": "string"
    },
    "supplier_company_number": {
      "type": "string"
    },
    "supplier_source_id": {
      "type": "string"
    },
    "project_source_id": {
      "type": "string"
    },
    "account_id": {
      "type": "string",
      "description": "Matched ALSight supplier account ID"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "dataverse_id": {
      "type": "string",
      "description": "Original cr78c_comsid GUID"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}