{
  "name": "COMS",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "coms_rate": {
      "type": "string"
    },
    "comsrate": {
      "type": "string"
    },
    "riba_stage": {
      "type": "string"
    },
    "project_ref": {
      "type": "string",
      "description": "PROJ reference, links to Project.project_number"
    },
    "supplier_company_number": {
      "type": "string",
      "description": "links to Account/Customer by company_number"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "dataverse_id": {
      "type": "string",
      "description": "Original cr78c_comsid GUID"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "regional_director"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        },
        {
          "user_condition": {
            "role": "finance"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}