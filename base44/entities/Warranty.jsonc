{
  "name": "Warranty",
  "type": "object",
  "properties": {
    "warranty_id": {
      "type": "string",
      "description": "CWY-XXXXX display ID"
    },
    "project_id": {
      "type": "string",
      "description": "Dataverse GUID of parent project"
    },
    "client_account_id": {
      "type": "string",
      "description": "Dataverse GUID of client account (backfilled from project for RLS)"
    },
    "bdm_aad_id": {
      "type": "string",
      "description": "BDM user id (backfilled from project for RLS)"
    },
    "account_id": {
      "type": "string",
      "description": "Dataverse GUID of account"
    },
    "supplier_id": {
      "type": "string",
      "description": "Dataverse GUID of supplier"
    },
    "services": {
      "type": "string"
    },
    "beneficiary": {
      "type": "string",
      "enum": [
        "council",
        ""
      ],
      "default": "council"
    },
    "category": {
      "type": "string",
      "enum": [
        "contractor",
        "consultant",
        "other",
        ""
      ],
      "default": ""
    },
    "warranty_status": {
      "type": "string",
      "enum": [
        "awaiting_jct",
        "awaiting_appointment",
        "in_review",
        "sent_for_seal",
        "drafted",
        "sealed",
        "executed",
        "product_warranty",
        ""
      ],
      "default": ""
    },
    "format": {
      "type": "string",
      "enum": [
        "deed",
        ""
      ],
      "default": ""
    },
    "jct_signed": {
      "type": "string",
      "format": "date-time"
    },
    "warranty_due": {
      "type": "string",
      "format": "date-time"
    },
    "practical_completion": {
      "type": "string",
      "format": "date-time"
    },
    "date_of_execution": {
      "type": "string",
      "format": "date-time"
    },
    "reminder_date": {
      "type": "string",
      "format": "date-time"
    },
    "drafted_date": {
      "type": "string",
      "format": "date-time"
    },
    "approval_status": {
      "type": "string"
    },
    "approval_date": {
      "type": "string",
      "format": "date-time"
    },
    "approval_comments": {
      "type": "string"
    },
    "approvers_name": {
      "type": "string"
    },
    "submit_for_approval": {
      "type": "boolean",
      "default": false
    },
    "link_to_file": {
      "type": "string"
    },
    "comments": {
      "type": "string"
    },
    "project_bsm_aad_id": {
      "type": "string"
    },
    "warranty_lead_aad_id": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "dataverse_id": {
      "type": "string",
      "description": "Original Dataverse bss_warrantyid GUID"
    }
  },
  "required": [
    "warranty_id"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "regional_director"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            },
            {
              "user_condition": {
                "role": "client"
              }
            },
            {
              "user_condition": {
                "role": "supplier"
              }
            },
            {
              "user_condition": {
                "role": "project_manager"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "data.supplier_id": "{{user.data.account_id}}"
            },
            {
              "data.client_account_id": "{{user.data.account_id}}"
            },
            {
              "data.bdm_aad_id": "{{user.id}}"
            },
            {
              "data.project_bsm_aad_id": "{{user.data.delegate_of}}"
            },
            {
              "data.bdm_aad_id": "{{user.data.delegate_of}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            },
            {
              "user_condition": {
                "role": "regional_director"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}