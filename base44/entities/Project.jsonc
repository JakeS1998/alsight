{
  "name": "Project",
  "type": "object",
  "properties": {
    "project_number": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "client_account_id": {
      "type": "string"
    },
    "client_name": {
      "type": "string"
    },
    "account_id": {
      "type": "string"
    },
    "related_supplier_account_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "department_id": {
      "type": "string"
    },
    "bdm_aad_id": {
      "type": "string"
    },
    "bsm_aad_id": {
      "type": "string"
    },
    "director_aad_id": {
      "type": "string"
    },
    "strategic_account_manager_aad_id": {
      "type": "string"
    },
    "project_manager_id": {
      "type": "string"
    },
    "client_rep_id": {
      "type": "string"
    },
    "client_rep2_id": {
      "type": "string"
    },
    "contractor_contact_id": {
      "type": "string"
    },
    "estimated_value": {
      "type": "number"
    },
    "construction_term_weeks": {
      "type": "number"
    },
    "procurement_route": {
      "type": "boolean"
    },
    "live_project": {
      "type": "boolean",
      "default": true
    },
    "approval_status": {
      "type": "string"
    },
    "aa_executed_date": {
      "type": "string",
      "format": "date-time"
    },
    "pq_approval_date": {
      "type": "string",
      "format": "date-time"
    },
    "practical_completion_date": {
      "type": "string",
      "format": "date-time"
    },
    "riba1_end": {
      "type": "string",
      "format": "date-time"
    },
    "riba1_term_weeks": {
      "type": "number"
    },
    "riba2_end": {
      "type": "string",
      "format": "date-time"
    },
    "riba2_term_weeks": {
      "type": "number"
    },
    "riba3_end": {
      "type": "string",
      "format": "date-time"
    },
    "riba3_term_weeks": {
      "type": "number"
    },
    "riba4_end": {
      "type": "string",
      "format": "date-time"
    },
    "riba4_term_weeks": {
      "type": "number"
    },
    "riba1_system_date": {
      "type": "string"
    },
    "riba2_system_date": {
      "type": "string"
    },
    "riba3_system_date": {
      "type": "string"
    },
    "riba4_system_date": {
      "type": "string"
    },
    "riba5_system_date": {
      "type": "string"
    },
    "site_postcode": {
      "type": "string"
    },
    "latitude": {
      "type": "number"
    },
    "longitude": {
      "type": "number"
    },
    "link_to_legals": {
      "type": "string"
    },
    "link_to_project_questionnaire": {
      "type": "string"
    },
    "link_to_pso": {
      "type": "string"
    },
    "link_to_pcs": {
      "type": "string"
    },
    "comments": {
      "type": "string"
    },
    "ie_commencement_date": {
      "type": "string",
      "format": "date-time"
    },
    "ie_value": {
      "type": "number"
    },
    "ie_comments": {
      "type": "string"
    },
    "insights_and_engagement": {
      "type": "boolean"
    },
    "payment_type": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ],
      "default": "active"
    },
    "dataverse_id": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "regional_director"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            },
            {
              "user_condition": {
                "role": "client"
              }
            },
            {
              "user_condition": {
                "role": "supplier"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.client_account_id": "{{user.data.account_id}}"
            },
            {
              "data.account_id": "{{user.data.account_id}}"
            },
            {
              "$and": [
                {
                  "user_condition": {
                    "role": "supplier"
                  }
                },
                {
                  "data.related_supplier_account_ids": "{{user.data.account_id}}"
                }
              ]
            },
            {
              "data.bdm_aad_id": "{{user.id}}"
            },
            {
              "data.bsm_aad_id": "{{user.id}}"
            },
            {
              "data.bdm_aad_id": "{{user.data.delegate_of}}"
            },
            {
              "data.bsm_aad_id": "{{user.data.delegate_of}}"
            },
            {
              "data.department_id": "{{user.data.region}}"
            },
            {
              "data.department_id": "{{user.data.delegate_region}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}