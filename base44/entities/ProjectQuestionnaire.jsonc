{
  "name": "ProjectQuestionnaire",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "request_draft_id": {
      "type": "string"
    },
    "scope_key": {
      "type": "string"
    },
    "template_version": {
      "type": "string"
    },
    "answers": {
      "type": "object",
      "additionalProperties": true
    },
    "source_import": {
      "type": "object",
      "additionalProperties": true,
      "description": "Linked SharePoint PQ import provenance, source evidence and any import error; legacy approval is read from the project PQ approval date."
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "submitted"
      ],
      "default": "draft"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "save_token": {
      "type": "string"
    },
    "saved_by": {
      "type": "string"
    },
    "saved_at": {
      "type": "string",
      "format": "date-time"
    },
    "submitted_by": {
      "type": "string"
    },
    "submitted_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "approval_round_id": {
      "type": "string"
    }
  },
  "required": [
    "template_version",
    "answers",
    "status",
    "revision"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}