{
  "name": "AllianceNotification",
  "type": "object",
  "properties": {
    "notification_key": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "post_id": {
      "type": "string"
    },
    "group_id": {
      "type": "string"
    },
    "reason": {
      "type": "string",
      "enum": [
        "company",
        "everyone",
        "mention"
      ]
    },
    "author_name": {
      "type": "string",
      "maxLength": 200
    },
    "read_at": {
      "type": "string",
      "format": "date-time"
    },
    "dismissed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "notification_key",
    "user_id",
    "post_id",
    "reason",
    "author_name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}