{
  "name": "DataverseConnection",
  "type": "object",
  "properties": {
    "key": {
      "type": "string",
      "enum": [
        "primary"
      ]
    },
    "environment_url": {
      "type": "string",
      "maxLength": 250
    },
    "status": {
      "type": "string",
      "enum": [
        "not_checked",
        "connected",
        "failed"
      ],
      "default": "not_checked"
    },
    "last_checked_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "organisation_id": {
      "type": "string"
    },
    "application_user_id": {
      "type": "string"
    },
    "last_error": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "key",
    "environment_url",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}