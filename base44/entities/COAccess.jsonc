{
  "name": "COAccess",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "user_name": {
      "type": "string"
    },
    "duty": {
      "type": "string",
      "enum": [
        "employee",
        "recovery_lead",
        "technical_administrator",
        "approving_administrator",
        "contingency_administrator"
      ],
      "enumColors": [
        "gray",
        "blue",
        "purple",
        "yellow",
        "green"
      ]
    },
    "dataset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 50
    },
    "can_edit": {
      "type": "boolean",
      "default": false
    },
    "active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id",
    "duty",
    "dataset_ids"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    },
    "update": {
      "user_condition": {
        "collaborator_role": "editor"
      }
    },
    "delete": false
  }
}