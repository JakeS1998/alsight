{
  "name": "FeeProposalFsf",
  "type": "object",
  "properties": {
    "fee_proposal_id": {
      "type": "string"
    },
    "project_id": {
      "type": "string"
    },
    "supplier_rates": {
      "type": "array",
      "maxItems": 250,
      "items": {
        "type": "object",
        "properties": {
          "supplier_key": {
            "type": "string",
            "maxLength": 2000
          },
          "fsf_pct": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          }
        },
        "required": [
          "supplier_key",
          "fsf_pct"
        ]
      }
    }
  },
  "required": [
    "fee_proposal_id",
    "project_id",
    "supplier_rates"
  ],
