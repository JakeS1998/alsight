{
  "name": "CRMReminder",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "opportunity_id": {
      "type": "string"
    },
    "activity_id": {
      "type": "string"
    },
    "subject": {
      "type": "string"
    },
    "remind_at": {
      "type": "string",
      "format": "date-time"
    },
    "dismissed_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "user_id",
    "opportunity_id",
    "subject",
    "remind_at"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "data.user_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}