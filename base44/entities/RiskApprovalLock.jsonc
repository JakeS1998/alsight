{
  "name": "RiskApprovalLock",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string"
    },
    "lease_until": {
      "type": "string",
      "default": "1970-01-01T00:00:00.000Z"
    },
    "lease_token": {
      "type": "string",
      "default": ""
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}