{
  "name": "ProjectDelivery",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Base44 id of parent project"
    },
    "client_account_id": {
      "type": "string",
      "description": "Backfilled from project for RLS"
    },
    "bdm_aad_id": {
      "type": "string",
      "description": "Backfilled from project for RLS"
    },
    "delivery_team": {
      "type": "string",
      "description": "JSON array of delivery team members with fees per RIBA stage"
    },
    "funding_route": {
      "type": "string"
    },
    "funding_route_notes": {
      "type": "string"
    },
    "scope_summary": {
      "type": "string"
    },
    "client_objectives": {
      "type": "string"
    },
    "initial_constraints": {
      "type": "string"
    },
    "target_programme": {
      "type": "string"
    },
    "key_stakeholders": {
      "type": "string"
    },
    "site_visit_completed": {
      "type": "boolean",
      "default": false
    },
    "feasibility_status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "complete",
        ""
      ]
    },
    "feasibility_notes": {
      "type": "string"
    },
    "probability": {
      "type": "number",
      "description": "Confidence %"
    },
    "next_action": {
      "type": "string"
    },
    "contract_sum": {
      "type": "number"
    },
    "contractor": {
      "type": "string"
    },
    "contract_start": {
      "type": "string",
      "format": "date"
    },
    "original_pc": {
      "type": "string",
      "format": "date"
    },
    "forecast_pc": {
      "type": "string",
      "format": "date"
    },
    "pct_programme": {
      "type": "number"
    },
    "pct_programme_override": {
      "type": "boolean",
      "description": "Use the saved manual programme percentage instead of live main-page dates"
    },
    "forecast_pc_override": {
      "type": "boolean",
      "description": "Use the saved manual forecast PC instead of main-page dates"
    },
    "lad_exposure_override": {
      "type": "boolean",
      "description": "Use the saved manual LAD assessment instead of the indicative date/rate calculation"
    },
    "lad_rate": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Contractual GBP LAD rate excluding VAT; null means not recorded"
    },
    "lad_rate_period": {
      "type": "string",
      "enum": [
        "day",
        "week"
      ],
      "default": "week"
    },
    "lad_stages": {
      "type": "array",
      "maxItems": 10,
      "description": "Ordered LAD charging stages. Each started period is charged in full; percentages use the contractor contract_sum excluding VAT. A null duration applies thereafter and must be the final stage. An empty array means no LAD schedule.",
      "items": {
        "type": "object",
        "properties": {
          "basis": {
            "type": "string",
            "enum": [
              "amount",
              "percentage"
            ]
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "period": {
            "type": "string",
            "enum": [
              "day",
              "week",
              "month",
              "year"
            ]
          },
          "periods": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "basis",
          "value",
          "period",
          "periods"
        ]
      }
    },
    "lad_completion_date": {
      "type": "string",
      "format": "date",
      "description": "Adjusted contractual completion date including agreed extensions of time"
    },
    "lad_terms": {
      "type": "string",
      "maxLength": 4000,
      "description": "LAD contractual terms and reference"
    },
    "lad_exposure_amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Indicative GBP LAD exposure calculated from the contractual rate and completion dates, stored when construction is saved; null means insufficient information. Not confirmation that LADs are payable."
    },
    "pct_cost": {
      "type": "number"
    },
    "current_valuation": {
      "type": "number"
    },
    "variations": {
      "type": "string"
    },
    "eot": {
      "type": "string"
    },
    "eot_notes": {
      "type": "string"
    },
    "lad_exposure": {
      "type": "string"
    },
    "lad_exposure_notes": {
      "type": "string"
    },
    "key_site_issues": {
      "type": "string"
    },
    "last_progress_meeting": {
      "type": "string",
      "format": "date"
    },
    "next_progress_meeting": {
      "type": "string",
      "format": "date"
    },
    "pc_achieved": {
      "type": "string",
      "format": "date"
    },
    "pc_certificate": {
      "type": "string"
    },
    "final_account_status": {
      "type": "string",
      "enum": [
        "open",
        "agreed",
        "closed",
        ""
      ]
    },
    "final_account_notes": {
      "type": "string"
    },
    "defects_period": {
      "type": "string"
    },
    "defects_period_notes": {
      "type": "string"
    },
    "retention": {
      "type": "string"
    },
    "retention_notes": {
      "type": "string"
    },
    "om_manuals": {
      "type": "string",
      "enum": [
        "outstanding",
        "partial",
        "complete",
        ""
      ]
    },
    "om_manuals_notes": {
      "type": "string"
    },
    "hs_file": {
      "type": "string",
      "enum": [
        "outstanding",
        "partial",
        "complete",
        ""
      ]
    },
    "hs_file_notes": {
      "type": "string"
    },
    "warranties_status": {
      "type": "string",
      "enum": [
        "outstanding",
        "partial",
        "complete",
        ""
      ]
    },
    "warranties_status_notes": {
      "type": "string"
    },
    "training": {
      "type": "string",
      "enum": [
        "outstanding",
        "partial",
        "complete",
        ""
      ]
    },
    "training_notes": {
      "type": "string"
    },
    "asset_info": {
      "type": "string",
      "enum": [
        "outstanding",
        "partial",
        "complete",
        ""
      ]
    },
    "asset_info_notes": {
      "type": "string"
    },
    "client_handover": {
      "type": "string",
      "enum": [
        "outstanding",
        "partial",
        "complete",
        ""
      ]
    },
    "client_handover_notes": {
      "type": "string"
    },
    "pso_pq_approved_by": {
      "type": "string"
    },
    "pso_pq_date": {
      "type": "string",
      "format": "date"
    },
    "pso_aa_approved_by": {
      "type": "string"
    },
    "pso_aa_date": {
      "type": "string",
      "format": "date"
    },
    "pso_aa_variations_approved_by": {
      "type": "string"
    },
    "pso_aa_variations_date": {
      "type": "string",
      "format": "date"
    },
    "pso_dma_approved_by": {
      "type": "string"
    },
    "pso_dma_date": {
      "type": "string",
      "format": "date"
    },
    "lessons_learned": {
      "type": "string"
    },
    "handover_started_at": {
      "type": "string",
      "format": "date-time"
    },
    "handover_started_by": {
      "type": "string"
    },
    "handover_applicability": {
      "type": "string",
      "enum": [
        "not_assessed",
        "applies",
        "does_not_apply"
      ]
    },
    "handover_items": {
      "type": "array",
      "maxItems": 15,
      "items": {
        "type": "object",
        "properties": {
          "key": {
            "type": "string",
            "enum": [
              "pc",
              "om",
              "hs",
              "as_builts",
              "warranties",
              "training",
              "assets",
              "defects",
              "final_account",
              "building_control",
              "compliance_declarations",
              "fire_safety",
              "ventilation",
              "energy_services",
              "epc"
            ]
          },
          "review_status": {
            "type": "string",
            "enum": [
              "automatic",
              "outstanding",
              "partial",
              "complete"
            ]
          },
          "notes": {
            "type": "string",
            "maxLength": 3000
          },
          "link": {
            "type": "string",
            "maxLength": 1000
          },
          "reviewed_by": {
            "type": "string"
          },
          "reviewed_at": {
            "type": "string",
            "format": "date-time"
          },
          "register_file_uri": {
            "type": "string"
          },
          "register_version": {
            "type": "integer",
            "minimum": 1
          },
          "register_count": {
            "type": "integer",
            "minimum": 0,
            "maximum": 50
          },
          "register_saved_by": {
            "type": "string"
          },
          "register_saved_at": {
            "type": "string",
            "format": "date-time"
          },
          "compliance_details": {
            "type": "object",
            "properties": {
              "provided": {
                "type": "string",
                "enum": [
                  "",
                  "No",
                  "Yes"
                ]
              },
              "recipient_id": {
                "type": "string",
                "maxLength": 1000
              },
              "recipient_name": {
                "type": "string",
                "maxLength": 1000
              },
              "date_issued": {
                "type": "string",
                "maxLength": 1000
              },
              "document_reference": {
                "type": "string",
                "maxLength": 1000
              },
              "acknowledgement": {
                "type": "string",
                "maxLength": 1000
              },
              "authority_notified": {
                "type": "string",
                "enum": [
                  "",
                  "No",
                  "Yes"
                ]
              },
              "notification_date": {
                "type": "string",
                "maxLength": 1000
              },
              "issuer": {
                "type": "string",
                "maxLength": 1000
              },
              "client_declaration": {
                "type": "string",
                "enum": [
                  "",
                  "No",
                  "Yes"
                ]
              },
              "designer_declaration": {
                "type": "string",
                "enum": [
                  "",
                  "No",
                  "Yes"
                ]
              },
              "contractor_declaration": {
                "type": "string",
                "enum": [
                  "",
                  "No",
                  "Yes"
                ]
              },
              "submitted": {
                "type": "string",
                "enum": [
                  "",
                  "No",
                  "Yes"
                ]
              }
            }
          },
          "documents": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "file_uri": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "size": {
                  "type": "number"
                },
                "version": {
                  "type": "string"
                },
                "actor": {
                  "type": "string"
                },
                "at": {
                  "type": "string",
                  "format": "date-time"
                },
                "superseded": {
                  "type": "boolean"
                }
              },
              "required": [
                "id",
                "file_uri",
                "name",
                "version"
              ]
            }
          }
        },
        "required": [
          "key"
        ]
      }
    },
    "handover_audit": {
      "type": "array",
      "maxItems": 500,
      "items": {
        "type": "object",
        "properties": {
          "at": {
            "type": "string",
            "format": "date-time"
          },
          "actor": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "key": {
            "type": "string"
          },
          "detail": {
            "type": "string",
            "maxLength": 6500
          }
        }
      }
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "regional_director"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            },
            {
              "user_condition": {
                "role": "client"
              }
            },
            {
              "user_condition": {
                "role": "supplier"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.client_account_id": "{{user.data.account_id}}"
            },
            {
              "data.bdm_aad_id": "{{user.id}}"
            },
            {
              "data.bdm_aad_id": "{{user.data.delegate_of}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "regional_director"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    }
  }
}