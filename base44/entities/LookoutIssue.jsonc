{
  "name": "LookoutIssue",
  "type": "object",
  "properties": {
    "week_key": {
      "type": "string"
    },
    "issue_number": {
      "type": "integer"
    },
    "publication_date": {
      "type": "string",
      "format": "date"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "approved",
        "publishing",
        "published"
      ],
      "default": "draft"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": true
    },
    "sources": {
      "type": "object",
      "additionalProperties": true
    },
    "content": {
      "type": "object",
      "additionalProperties": true
    },
    "revision": {
      "type": "integer",
      "default": 1
    },
    "approved_revision": {
      "type": "integer"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_by_name": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "draft_pdf_file_uri": {
      "type": "string"
    },
    "pdf_file_uri": {
      "type": "string"
    },
    "published_at": {
      "type": "string",
      "format": "date-time"
    },
    "pulse_post_id": {
      "type": "string"
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "week_key",
    "issue_number",
    "publication_date",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "$and": [
            {
              "data.status": "published"
            },
            {
              "$or": [
                {
                  "user_condition": {
                    "role": "director"
                  }
                },
                {
                  "user_condition": {
                    "role": "regional_director"
                  }
                },
                {
                  "user_condition": {
                    "role": "bsm"
                  }
                },
                {
                  "user_condition": {
                    "role": "bdm"
                  }
                },
                {
                  "user_condition": {
                    "role": "finance"
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": false
  }
}