    },
    "actor_id": {
      "type": "string"
    },
    "actor_name": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "changes": {
      "type": "object",
      "additionalProperties": true
    }
