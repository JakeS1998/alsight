{
  "name": "FeeProposal",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "Base44 id of parent project"
    },
    "client_account_id": {
      "type": "string",
      "description": "Backfilled from project for RLS"
    },
    "bdm_aad_id": {
      "type": "string",
      "description": "Backfilled from project for RLS"
    },
    "revision_number": {
      "type": "number",
      "default": 1
    },
    "fee_value": {
      "type": "number"
    },
    "fee_basis": {
      "type": "string",
      "enum": [
        "fixed",
        "percentage",
        "day_rate",
        ""
      ]
    },
    "services_included": {
      "type": "string"
    },
    "services_excluded": {
      "type": "string"
    },
    "consultants_required": {
      "type": "string"
    },
    "supplier_quotes_received": {
      "type": "string"
    },
    "external_cost": {
      "type": "number"
    },
    "margin_pct": {
      "type": "number"
    },
    "line_items": {
      "type": "string",
      "description": "JSON array of fee proposal line items"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "internal_review",
        "sent",
        "negotiation",
        "accepted",
        "lost"
      ],
      "default": "draft"
    },
    "date_issued": {
      "type": "string",
      "format": "date"
    },
    "client_approval_date": {
      "type": "string",
      "format": "date"
    },
    "link_to_file": {
      "type": "string"
    },
    "is_current": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "project_id"
  ],
  "rls": {
    "read": {
      "$and": [
        {
          "$or": [
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "regional_director"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            },
            {
              "user_condition": {
                "role": "client"
              }
            },
            {
              "user_condition": {
                "role": "supplier"
              }
            },
            {
              "user_condition": {
                "role": "project_manager"
              }
            }
          ]
        },
        {
          "$or": [
            {
              "data.client_account_id": "{{user.data.account_id}}"
            },
            {
              "data.bdm_aad_id": "{{user.id}}"
            },
            {
              "data.bdm_aad_id": "{{user.data.delegate_of}}"
            },
            {
              "user_condition": {
                "role": "admin"
              }
            },
            {
              "user_condition": {
                "role": "director"
              }
            },
            {
              "user_condition": {
                "role": "regional_director"
              }
            },
            {
              "user_condition": {
                "role": "bsm"
              }
            },
            {
              "user_condition": {
                "role": "finance"
              }
            },
            {
              "user_condition": {
                "role": "bdm"
              }
            }
          ]
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        },
        {
          "user_condition": {
            "role": "bdm"
          }
        },
        {
          "user_condition": {
            "role": "bsm"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "director"
          }
        }
      ]
    }
  }
}